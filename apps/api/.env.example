AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=https://openrouter.ai/api/v1
DATABASE_URL=sqlite+aiosqlite:///./creatoros.db
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# true = allow local "dev:" bearer when Clerk JWKS is unset
AUTH_DEV_BYPASS=true

# --- Clerk JWT verification (required when web Clerk is enabled) ---
# From Clerk Dashboard → API Keys / Configure:
# JWKS: https://<your-clerk-domain>/.well-known/jwks.json
# Issuer: https://<your-clerk-domain>
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
